# API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Model ID (required)
MODEL_ID=claude-sonnet-4-5

# Base URL (optional, for Anthropic-compatible providers)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Context window for the auto-compact threshold (optional, min semantics; default 200000).
# Only values smaller than the default take effect; the trigger line is window - 33000.
# AUTO_COMPACT_WINDOW=100000
